{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  constraints: {
    // Must be kept in sync with the major-minor version of Python
    // being used in the base containers in the Dockerfile.
    python: "==3.14",
  },

  customManagers: [
    {
      customType: "regex",
      datasourceTemplate: "pypi",
      managerFilePatterns: ["Dockerfile"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=pypi\\s+depName=(?<depName>\\S+)\\s*(ENV|ARG)?\\s*.+_VERSION=(?<currentValue>\\S+)",
      ],
    },
    {
      customType: "regex",
      datasourceTemplate: "deb",
      managerFilePatterns: ["Dockerfile"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=deb\\s+depName=(?<depName>\\S+)\\s*(ENV|ARG)?\\s*.+_VERSION=(?<currentValue>\\S+)",
      ],
      // The suite here must be kept in sync with the Debian release
      // used in the base containers in the Dockerfile.
      //
      // Note also that the same package version is offered for all
      // architectures.  In rare cases this is not the case.
      registryUrlTemplate: "https://deb.debian.org/debian?suite=trixie&components=main,contrib,non-free&binaryArch=amd64",
    },
    {
      customType: "regex",
      // The github-tags datasource supports digest lookups, so Renovate
      // can update the commit SHA in the archive URL and the release tag
      // in the trailing comment together.
      datasourceTemplate: "github-tags",
      depNameTemplate: "cisagov/mongo-db-from-config",
      managerFilePatterns: ["/^src/Pipfile$/"],
      matchStrings: [
        'cisagov/mongo-db-from-config/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz"}\\s*#\\s*(?<currentValue>v\\S+)',
      ],
      versioningTemplate: "semver-coerced", // handles the leading `v`
    },
    {
      customType: "regex",
      // Track the head of the upstream default branch; the recorded pin
      // is the commit digest in the Dockerfile ARG. The accompanying
      // DOMAIN_SCAN_SHA256 ARG must be updated by hand on each bump (see
      // the comment in the Dockerfile).
      currentValueTemplate: "master",
      datasourceTemplate: "git-refs",
      depNameTemplate: "cisagov/domain-scan",
      managerFilePatterns: ["Dockerfile"],
      matchStrings: ["ARG DOMAIN_SCAN_REF=(?<currentDigest>[0-9a-f]{40})"],
      packageNameTemplate: "https://github.com/cisagov/domain-scan",
    },
  ],
  dependencyDashboard: true,
  enabledManagers: ["custom.regex"],
  extends: ["config:recommended"],
  labels: ["dependencies"],
}
